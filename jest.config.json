{
    "moduleFileExtensions": [
        "js",
        "json",
        "ts"
    ],
    "rootDir": ".",
    "testRegex": ".*\\.test\\.ts$",
    "transform": {
        "^.+\\.(t|j)s$": [
            "ts-jest"
        ]
    },
    "collectCoverage": true,
    "coverageDirectory": "coverage",
    "testEnvironment": "node",
    "transformIgnorePatterns": ["/node_modules/"],
    "testPathIgnorePatterns": [
        "/node_modules/",
        "/dist/"
    ],
    "verbose": true,
    "testTimeout": 30000
}