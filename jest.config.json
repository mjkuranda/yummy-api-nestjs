{
    "moduleFileExtensions": [
        "js",
        "json",
        "ts"
    ],
    "rootDir": ".",
    "testRegex": ".*\\.test\\.ts$",
    "transform": {
        "^.+\\.(t|j)s$": [
            "@swc/jest"
        ]
    },
    "collectCoverage": true,
    "coverageDirectory": "coverage",
    "testEnvironment": "node",
    "transformIgnorePatterns": ["/node_modules/"],
    "testPathIgnorePatterns": [
        "/node_modules/",
        "/dist/",
        "/__mocks__/",
        "/__fixtures__/"
    ],
    "coveragePathIgnorePatterns": [
        "/node_modules/",
        "/dist/",
        "/__mocks__/",
        "/__fixtures__/"
    ],
    "collectCoverageFrom": [
        "src/**/*.ts",
        "!**/__tests__/**",
        "!**/*.d.ts"
    ],
    "verbose": true,
    "testTimeout": 30000
}